# Netlify response headers (scripts/serve-dist.mjs mirrors them; a test keeps the two in sync).

# Basic hardening for every response: no MIME sniffing, no framing (clickjacking), a referrer
# without the full URL for other sites, and no access to device features the site never uses.
# No full Content-Security-Policy yet: the inline JSON-LD and script loader would need hashes.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Files in /assets have a content hash in their name, so they never change and browsers may
# keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
